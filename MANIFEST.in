# sdist contents for ai-configurator. Hatchling reads the modern
# packaging-data declaration in pyproject.toml; this file is a
# belt-and-braces fallback for older tools that read MANIFEST.in.

include README.md
include SPEC.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include pyproject.toml
include MANIFEST.in
include .editorconfig
include .gitignore
include Makefile

recursive-include src/ai_configurator *.py py.typed
recursive-include src/ai_configurator/resources/decisions *.json *.md *.fragment
recursive-include docs *.md
recursive-include tests *.py
recursive-include examples *

# Exclude caches + builds + secrets: defence in depth on top of .gitignore
global-exclude *.pyc
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *.swp
global-exclude *.swo
global-exclude *~
global-exclude .env
global-exclude .env.*
recursive-exclude dist *
recursive-exclude build *
recursive-exclude .venv *
recursive-exclude .mypy_cache *
recursive-exclude .pytest_cache *
recursive-exclude .ruff_cache *
