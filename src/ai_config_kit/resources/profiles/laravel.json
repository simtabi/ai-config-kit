{
  "_meta": {
    "name": "laravel",
    "summary": "PHP / Laravel project profile: composer, artisan, all vendor/bin tools (pest, phpunit, pint, phpstan, rector), Sail, Node for assets. Denies migrate:fresh + db:wipe at the project level. Extends `global` baseline.",
    "scope_hint": "project",
    "extends": ["global"]
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "MultiEdit",

      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git pull:*)",
      "Bash(git push)",
      "Bash(git push origin:*)",
      "Bash(git push --set-upstream:*)",
      "Bash(git push -u:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git stash push:*)",
      "Bash(git stash pop)",
      "Bash(git stash apply:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git init:*)",

      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh workflow view:*)",

      "Bash(php:*)",
      "Bash(php -v)",
      "Bash(php -m)",
      "Bash(php -i)",
      "Bash(php -r:*)",
      "Bash(php artisan:*)",
      "Bash(./artisan:*)",

      "Bash(composer:*)",
      "Bash(composer install:*)",
      "Bash(composer update:*)",
      "Bash(composer require:*)",
      "Bash(composer remove:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(composer run:*)",
      "Bash(composer test:*)",
      "Bash(composer validate:*)",
      "Bash(composer audit:*)",

      "Bash(./vendor/bin/pest:*)",
      "Bash(./vendor/bin/phpunit:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(./vendor/bin/php-cs-fixer:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(./vendor/bin/psalm:*)",
      "Bash(./vendor/bin/rector:*)",
      "Bash(./vendor/bin/infection:*)",
      "Bash(./vendor/bin/*:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(vendor/bin/*:*)",

      "Bash(npm:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",

      "Bash(make:*)",
      "Bash(./scripts/*:*)",
      "Bash(bash scripts/*:*)",

      "Bash(pre-commit:*)",
      "Bash(shellcheck:*)",
      "Bash(detect-secrets:*)",
      "Bash(gitleaks:*)",

      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(docker exec:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose exec:*)",
      "Bash(sail:*)",
      "Bash(./vendor/bin/sail:*)",

      "Bash(rm:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ln:*)",
      "Bash(chmod:*)",
      "Bash(tar:*)",
      "Bash(unzip:*)",
      "Bash(zip:*)"
    ],
    "deny": [
      "Bash(rm -rf .git:*)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf vendor:*)",
      "Bash(rm -rf node_modules:*)",
      "Bash(rm -rf storage/logs:*)",

      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan migrate:reset:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(./artisan migrate:fresh:*)",
      "Bash(./artisan migrate:reset:*)",
      "Bash(./artisan db:wipe:*)",

      "Bash(composer publish:*)",

      "Bash(gh pr merge --auto:*)"
    ]
  }
}
