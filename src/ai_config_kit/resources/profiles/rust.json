      "Bash(git stash:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git init:*)",
      "Bash(git tag:*)",

      "Bash(gh pr create:*)",
