      "Bash(cargo install:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo audit:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo expand:*)",
